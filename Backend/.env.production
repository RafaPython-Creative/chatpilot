# Modelo de variáveis de ambiente de produção.
# NÃO coloque valores reais aqui: os segredos são injetados pelo
# ambiente de deploy / secret manager.

NODE_ENV=production
PORT=3000
CORS_ORIGINS=

# Banco de dados
DATABASE_URL=
DB_ADMIN_PASSWORD=

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=

# Provedores de IA / mensageria
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=
WHATSAPP_CLOUD_TOKEN=

# Infra
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=
